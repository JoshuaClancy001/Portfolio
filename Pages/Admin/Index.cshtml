@page
@model Portfolio.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<h1 class="font-heading text-4xl mb-12">Dashboard</h1>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
    <div class="border border-border p-6 bg-secondary">
        <div class="font-heading text-4xl text-foreground mb-1">@Model.TotalProjects</div>
        <div class="text-sm text-muted-foreground">total projects</div>
    </div>
    <div class="border border-border p-6 bg-secondary">
        <div class="font-heading text-4xl text-foreground mb-1">@Model.PublicProjects</div>
        <div class="text-sm text-muted-foreground">public</div>
    </div>
    <div class="border border-border p-6 bg-secondary">
        <div class="font-heading text-4xl mb-1 @(Model.UnreadMessages > 0 ? "text-accent" : "text-foreground")">@Model.UnreadMessages</div>
        <div class="text-sm text-muted-foreground">unread messages</div>
    </div>
</div>

<div class="flex gap-4 flex-wrap">
    <a href="/Admin/Projects"
       class="px-6 py-3 border border-accent text-accent hover:bg-accent hover:text-background transition-colors text-sm">
        manage projects →
    </a>
    <a href="/Admin/Messages"
       class="px-6 py-3 border border-border text-muted-foreground hover:text-foreground hover:border-muted-foreground transition-colors text-sm">
        view messages →
    </a>
</div>
