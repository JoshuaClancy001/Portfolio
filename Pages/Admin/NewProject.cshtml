@page
@model Portfolio.Pages.Admin.NewProjectModel
@{
    ViewData["Title"] = "New Project";
    Layout = "_AdminLayout";
}

<div class="mb-10">
    <a href="/Admin/Projects" class="text-sm text-muted-foreground hover:text-foreground transition-colors">← back</a>
    <h1 class="font-heading text-4xl mt-2">New Project</h1>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p class="text-red-400 text-sm mb-6">@Model.ErrorMessage</p>
}

<form method="post" class="space-y-5 max-w-2xl">
    @Html.AntiForgeryToken()
    <partial name="_ProjectForm" model="Model.Input" />
    <div class="flex gap-4 pt-2">
        <button type="submit" class="px-8 py-3 bg-accent text-background hover:opacity-90 transition-opacity text-sm">
            Create project
        </button>
        <a href="/Admin/Projects"
           class="px-8 py-3 border border-border text-muted-foreground hover:text-foreground hover:border-muted-foreground transition-colors text-sm">
            Cancel
        </a>
    </div>
</form>
