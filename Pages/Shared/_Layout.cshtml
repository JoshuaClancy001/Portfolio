<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")Josh Clancy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#1a1a1a',
                        foreground: '#f5f5f0',
                        secondary: '#2a2a2a',
                        border: '#2a2a2a',
                        'muted-foreground': '#a0a0a0',
                        accent: '#ff6b35',
                    },
                    fontFamily: {
                        heading: ['Fraunces', 'serif'],
                        body: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
</head>
<body class="min-h-screen flex flex-col bg-background text-foreground">
    @{
        var path = Context.Request.Path.ToString().ToLower();
        string NavLink(string href, string label) {
            bool active = href == "/" ? path == "/" : path.StartsWith(href.ToLower());
            string cls = active
                ? "text-sm tracking-wide text-accent"
                : "text-sm tracking-wide text-muted-foreground hover:text-foreground transition-colors";
            return $"<a href=\"{href}\" class=\"{cls}\">{label}</a>";
        }
    }
    <nav class="border-b border-border">
        <div class="max-w-7xl mx-auto px-6 md:px-12 py-6">
            <div class="flex items-center justify-between">
                <a href="/" class="font-heading text-lg opacity-50 hover:opacity-100 transition-opacity">JC</a>
                <div class="flex gap-8">
                    @Html.Raw(NavLink("/", "Home"))
                    @Html.Raw(NavLink("/Projects", "Projects"))
                    @Html.Raw(NavLink("/Roadmap", "Roadmap"))
                    @Html.Raw(NavLink("/Contact", "Contact"))
                </div>
            </div>
        </div>
    </nav>
    <main class="flex-1">
        @RenderBody()
    </main>
    <footer class="border-t border-border">
        <div class="max-w-7xl mx-auto px-6 md:px-12 py-6 flex items-center justify-between">
            <span class="text-xs text-muted-foreground">Josh Clancy</span>
            <a href="https://github.com/JoshuaClancy001" target="_blank" rel="noopener noreferrer"
               class="text-xs text-muted-foreground hover:text-foreground transition-colors">GitHub</a>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
