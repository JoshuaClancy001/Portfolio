@model Portfolio.Pages.Admin.ProjectFormInput

<div>
    <label class="block text-sm text-muted-foreground mb-2">Title</label>
    <input asp-for="Title" type="text"
           class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors text-foreground" />
    <span asp-validation-for="Title" class="text-red-400 text-xs mt-1 block"></span>
</div>

<div>
    <label class="block text-sm text-muted-foreground mb-2">Description</label>
    <textarea asp-for="Description" rows="3"
              class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors resize-none text-foreground"></textarea>
    <span asp-validation-for="Description" class="text-red-400 text-xs mt-1 block"></span>
</div>

<div class="grid grid-cols-2 gap-4">
    <div>
        <label class="block text-sm text-muted-foreground mb-2">Status</label>
        <select asp-for="Status"
                class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors text-foreground">
            <option value="Planned">Planned</option>
            <option value="InProgress">In Progress</option>
            <option value="Shipped">Shipped</option>
            <option value="Paused">Paused</option>
        </select>
    </div>
    <div>
        <label class="block text-sm text-muted-foreground mb-2">Sort Order</label>
        <input asp-for="SortOrder" type="number" min="1"
               class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors text-foreground" />
    </div>
</div>

<div class="grid grid-cols-2 gap-4">
    <div>
        <label class="block text-sm text-muted-foreground mb-2">Repo URL</label>
        <input asp-for="RepoUrl" type="url" placeholder="https://github.com/..."
               class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors text-foreground" />
    </div>
    <div>
        <label class="block text-sm text-muted-foreground mb-2">Live URL</label>
        <input asp-for="LiveUrl" type="url" placeholder="https://..."
               class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors text-foreground" />
    </div>
</div>

<div>
    <label class="block text-sm text-muted-foreground mb-2">
        Tags <span class="text-muted-foreground opacity-50">(comma-separated)</span>
    </label>
    <input asp-for="Tags" type="text" placeholder="ASP.NET Core, C#, PostgreSQL"
           class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors text-foreground" />
</div>

<div class="flex items-center gap-3">
    <input asp-for="IsPublic" type="checkbox" class="w-4 h-4 accent-accent" />
    <label asp-for="IsPublic" class="text-sm text-muted-foreground">Visible to public</label>
</div>
