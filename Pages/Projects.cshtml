@page
@model ProjectsModel
@{
    ViewData["Title"] = "Projects";
    var statuses = new[] { "All", "Planned", "InProgress", "Shipped", "Paused" };
    var labels = new Dictionary<string, string> {
        ["All"] = "All", ["Planned"] = "Planned",
        ["InProgress"] = "In Progress", ["Shipped"] = "Shipped", ["Paused"] = "Paused"
    };
}

<div class="max-w-7xl mx-auto px-6 md:px-12 py-16">

    <div class="mb-16">
        <h1 class="font-heading text-4xl md:text-6xl mb-6 tracking-tight">Projects</h1>
        <div class="flex gap-3 flex-wrap" id="filters">
            @foreach (var s in statuses)
            {
                <button onclick="filterProjects('@s')"
                        data-filter="@s"
                        class="px-4 py-2 text-sm border transition-colors border-border text-muted-foreground hover:text-foreground hover:border-muted-foreground">
                    @labels[s]
                </button>
            }
        </div>
    </div>

    @if (!Model.Projects.Any())
    {
        <p class="text-muted-foreground">No projects yet.</p>
    }
    else
    {
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
            @foreach (var project in Model.Projects)
            {
                <div data-status="@project.Status" onclick="window.location='/Projects/@project.Id'"
                     class="p-6 bg-secondary border border-border hover:border-accent transition-colors flex flex-col cursor-pointer group">
                    <div class="flex items-start justify-between mb-3">
                        <h3 class="font-heading flex-1 group-hover:text-accent transition-colors">@project.Title</h3>
                        <span class="text-xs px-2 py-1 ml-3 flex-shrink-0 text-background"
                              style="background-color: @StatusColor(project.Status)">
                            @labels.GetValueOrDefault(project.Status, project.Status)
                        </span>
                    </div>
                    <p class="text-sm text-muted-foreground mb-4 flex-1">@project.Description</p>
                    <div class="flex flex-wrap gap-2 mt-auto">
                        @foreach (var tag in project.Tags)
                        {
                            <span class="text-xs px-2 py-1 bg-background text-muted-foreground border border-border">@tag</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(project.RepoUrl) || !string.IsNullOrEmpty(project.LiveUrl))
                    {
                        <div class="flex gap-4 mt-4 pt-4 border-t border-border text-xs" onclick="event.stopPropagation()">
                            @if (!string.IsNullOrEmpty(project.RepoUrl))
                            {
                                <a href="@project.RepoUrl" target="_blank" class="text-muted-foreground hover:text-accent transition-colors">repo →</a>
                            }
                            @if (!string.IsNullOrEmpty(project.LiveUrl))
                            {
                                <a href="@project.LiveUrl" target="_blank" class="text-muted-foreground hover:text-accent transition-colors">live →</a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <p id="no-results" class="hidden text-center py-20 text-muted-foreground">No projects found.</p>
    }

</div>

@functions {
    string StatusColor(string status) => status switch
    {
        "InProgress" => "var(--status-inprogress)",
        "Shipped"    => "var(--status-shipped)",
        "Planned"    => "var(--status-planned)",
        "Paused"     => "var(--status-paused)",
        _            => "var(--status-planned)"
    };
}

@section Scripts {
<script>
function filterProjects(status) {
    const cards = document.querySelectorAll('[data-status]');
    let visible = 0;
    cards.forEach(card => {
        const show = status === 'All' || card.dataset.status === status;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    document.getElementById('no-results')?.classList.toggle('hidden', visible > 0);

    document.querySelectorAll('[data-filter]').forEach(btn => {
        const active = btn.dataset.filter === status;
        btn.style.borderColor = active ? 'var(--accent)' : '';
        btn.style.color = active ? 'var(--accent)' : '';
    });
}

// Set "All" active on load
filterProjects('All');
document.querySelector('[data-filter="All"]').style.borderColor = 'var(--accent)';
document.querySelector('[data-filter="All"]').style.color = 'var(--accent)';
</script>
}
