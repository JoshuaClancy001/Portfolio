@page
@model ContactModel
@{
    ViewData["Title"] = "Contact";
}

<div class="max-w-2xl mx-auto px-6 md:px-12 py-16">

    <div class="mb-16">
        <h1 class="font-heading text-4xl md:text-6xl mb-6 tracking-tight">Contact</h1>
        <p class="text-muted-foreground max-w-xl">
            Open to conversations about .NET, backend systems, or potential roles.
            I read every message.
        </p>
    </div>

    @if (Model.Sent)
    {
        <p class="text-accent text-sm mb-6">Message received. I'll get back to you soon.</p>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="text-red-400 text-sm mb-6">@Model.ErrorMessage</p>
    }

    <form method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <div>
            <label class="block text-sm mb-2 text-muted-foreground" asp-for="Input.Name">Name</label>
            <input asp-for="Input.Name" type="text" autocomplete="name"
                   class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors text-foreground" />
            <span asp-validation-for="Input.Name" class="text-red-400 text-xs mt-1 block"></span>
        </div>
        <div>
            <label class="block text-sm mb-2 text-muted-foreground" asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" type="email" autocomplete="email"
                   class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors text-foreground" />
            <span asp-validation-for="Input.Email" class="text-red-400 text-xs mt-1 block"></span>
        </div>
        <div>
            <label class="block text-sm mb-2 text-muted-foreground" asp-for="Input.Body">Message</label>
            <textarea asp-for="Input.Body" rows="6"
                      class="w-full px-4 py-3 bg-secondary border border-border focus:border-accent outline-none transition-colors resize-none text-foreground"></textarea>
            <span asp-validation-for="Input.Body" class="text-red-400 text-xs mt-1 block"></span>
        </div>
        <button type="submit"
                class="px-8 py-3 bg-accent text-background hover:opacity-90 transition-opacity font-medium">
            Send Message
        </button>
    </form>

</div>
