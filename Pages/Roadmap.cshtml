@page
@model RoadmapModel
@{
    ViewData["Title"] = "Roadmap";
    var statusOrder = new Dictionary<string, int> {
        ["InProgress"] = 0, ["Planned"] = 1, ["Shipped"] = 2, ["Paused"] = 3
    };
    var labels = new Dictionary<string, string> {
        ["All"] = "All", ["InProgress"] = "In Progress",
        ["Planned"] = "Planned", ["Shipped"] = "Shipped", ["Paused"] = "Paused"
    };
    var sorted = Model.Projects
        .OrderBy(p => statusOrder.GetValueOrDefault(p.Status, 99))
        .ToList();
}

<div class="max-w-4xl mx-auto px-6 md:px-12 py-16">

    <div class="mb-16">
        <h1 class="font-heading text-4xl md:text-6xl mb-4 tracking-tight">Roadmap</h1>
        <p class="text-muted-foreground mb-8 max-w-2xl">
            A running log of what I'm building, what I've shipped, and what's coming next.
            Expand each project to see the full changelog.
        </p>
        <div class="flex gap-3 flex-wrap">
            @foreach (var s in new[] { "All", "InProgress", "Planned", "Shipped", "Paused" })
            {
                <button onclick="filterRoadmap('@s')" data-filter="@s"
                        class="px-4 py-2 text-sm border transition-colors border-border text-muted-foreground hover:text-foreground hover:border-muted-foreground">
                    @labels[s]
                </button>
            }
        </div>
    </div>

    @if (!sorted.Any())
    {
        <p class="text-muted-foreground">No projects yet.</p>
    }
    else
    {
        <div class="space-y-0" id="roadmap-list">
            @foreach (var project in sorted)
            {
                var entries = Model.Changelog.TryGetValue(project.Id, out var e) ? e : [];
                var dotColor = project.Status switch {
                    "Shipped"    => "var(--status-shipped)",
                    "InProgress" => "var(--status-inprogress)",
                    "Paused"     => "var(--status-paused)",
                    _            => "var(--status-planned)"
                };

                <div data-status="@project.Status" class="border-l-2 border-border pl-8 pb-12 relative">
                    <div class="absolute left-0 top-0 w-4 h-4 rounded-full border-4 border-background"
                         style="background-color: @dotColor; transform: translateX(-0.5625rem)"></div>

                    <details>
                        <summary class="group w-full text-left">
                            <div class="flex items-start justify-between mb-2">
                                <div class="flex items-center gap-3">
                                    <span class="text-muted-foreground text-sm select-none">▶</span>
                                    <h3 class="font-heading group-hover:text-accent transition-colors">@project.Title</h3>
                                </div>
                                <span class="text-xs px-2 py-1 ml-3 flex-shrink-0 text-background"
                                      style="background-color: @dotColor">
                                    @labels.GetValueOrDefault(project.Status, project.Status)
                                </span>
                            </div>
                            @if (project.TargetDate.HasValue)
                            {
                                <div class="ml-7 text-xs text-muted-foreground">
                                    @project.TargetDate.Value.ToString("MMMM d, yyyy")
                                </div>
                            }
                        </summary>

                        @if (!string.IsNullOrEmpty(project.Description))
                        {
                            <p class="ml-7 mt-3 text-sm text-muted-foreground">@project.Description</p>
                        }

                        @if (entries.Any())
                        {
                            <div class="ml-7 mt-6 space-y-3">
                                @foreach (var entry in entries.OrderByDescending(e => e.CreatedAt))
                                {
                                    <div class="pl-4 py-2 border-l-2 @(entry.IsMilestone ? "border-accent" : "border-border")">
                                        <div class="text-xs text-muted-foreground mb-1">
                                            @entry.CreatedAt.ToString("MMM d, yyyy")
                                        </div>
                                        <div class="text-sm @(entry.IsMilestone ? "text-accent" : "")">
                                            @if (entry.IsMilestone) { <text>✦ </text> }
                                            @entry.Content
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </details>
                </div>
            }
        </div>
        <p id="no-results" class="hidden text-center py-20 text-muted-foreground">No projects found.</p>
    }

</div>

@section Scripts {
<script>
function filterRoadmap(status) {
    const items = document.querySelectorAll('[data-status]');
    let visible = 0;
    items.forEach(item => {
        const show = status === 'All' || item.dataset.status === status;
        item.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    document.getElementById('no-results')?.classList.toggle('hidden', visible > 0);

    document.querySelectorAll('[data-filter]').forEach(btn => {
        const active = btn.dataset.filter === status;
        btn.style.borderColor = active ? 'var(--accent)' : '';
        btn.style.color = active ? 'var(--accent)' : '';
    });
}

// Replace ▶ with ▼ when open
document.querySelectorAll('details').forEach(d => {
    d.addEventListener('toggle', () => {
        const arrow = d.querySelector('summary span');
        if (arrow) arrow.textContent = d.open ? '▼' : '▶';
    });
});

filterRoadmap('All');
document.querySelector('[data-filter="All"]').style.borderColor = 'var(--accent)';
document.querySelector('[data-filter="All"]').style.color = 'var(--accent)';
</script>
}
