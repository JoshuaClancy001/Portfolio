@page "/Projects/{id:guid}"
@model Portfolio.Pages.ProjectDetailModel
@{
    ViewData["Title"] = Model.Project?.Title ?? "Project";
    var statusLabels = new Dictionary<string, string> {
        ["Planned"] = "Planned", ["InProgress"] = "In Progress",
        ["Shipped"] = "Shipped", ["Paused"] = "Paused"
    };
}

@functions {
    string StatusColor(string status) => status switch
    {
        "InProgress" => "var(--status-inprogress)",
        "Shipped"    => "var(--status-shipped)",
        "Planned"    => "var(--status-planned)",
        "Paused"     => "var(--status-paused)",
        _            => "var(--status-planned)"
    };
}

@if (Model.Project is null)
{
    <div class="max-w-7xl mx-auto px-6 md:px-12 py-16">
        <p class="text-muted-foreground">Project not found.</p>
    </div>
}
else
{
    var p = Model.Project;
    <div class="max-w-4xl mx-auto px-6 md:px-12 py-16">

        <div class="mb-4">
            <a href="/Projects" class="text-sm text-muted-foreground hover:text-foreground transition-colors">← Projects</a>
        </div>

        <!-- Header -->
        <div class="mb-10">
            <div class="flex items-start gap-4 flex-wrap mb-4">
                <h1 class="font-heading text-4xl md:text-5xl flex-1">@p.Title</h1>
                <span class="text-sm px-3 py-1 text-background mt-1"
                      style="background-color: @StatusColor(p.Status)">
                    @statusLabels.GetValueOrDefault(p.Status, p.Status)
                </span>
            </div>
            <p class="text-muted-foreground text-lg leading-relaxed">@p.Description</p>
        </div>

        <!-- Links -->
        @if (!string.IsNullOrEmpty(p.RepoUrl) || !string.IsNullOrEmpty(p.LiveUrl))
        {
            <div class="flex gap-6 mb-10">
                @if (!string.IsNullOrEmpty(p.RepoUrl))
                {
                    <a href="@p.RepoUrl" target="_blank" rel="noopener noreferrer"
                       class="px-6 py-3 border border-border text-muted-foreground hover:text-foreground hover:border-muted-foreground transition-colors text-sm">
                        View Repo →
                    </a>
                }
                @if (!string.IsNullOrEmpty(p.LiveUrl))
                {
                    <a href="@p.LiveUrl" target="_blank" rel="noopener noreferrer"
                       class="px-6 py-3 bg-accent text-background hover:opacity-90 transition-opacity text-sm">
                        Live Site →
                    </a>
                }
            </div>
        }

        <!-- Tags -->
        @if (p.Tags.Any())
        {
            <div class="flex flex-wrap gap-2 mb-10">
                @foreach (var tag in p.Tags)
                {
                    <span class="text-xs px-3 py-1.5 bg-secondary border border-border text-muted-foreground">@tag</span>
                }
            </div>
        }

        <!-- Summary / full write-up -->
        @if (!string.IsNullOrEmpty(p.Summary))
        {
            <section class="mb-12">
                <h2 class="font-heading text-2xl mb-6">Overview</h2>
                <div class="text-muted-foreground leading-relaxed whitespace-pre-wrap">@p.Summary</div>
            </section>
        }

        <!-- Screenshots -->
        @if (p.Images.Any())
        {
            <section class="mb-12">
                <h2 class="font-heading text-2xl mb-6">Screenshots</h2>
                <div class="grid md:grid-cols-2 gap-4">
                    @foreach (var image in p.Images)
                    {
                        <div class="border border-border overflow-hidden bg-secondary">
                            <img src="@image.Url"
                                 alt="@(image.AltText ?? p.Title)"
                                 class="w-full object-cover" />
                            @if (!string.IsNullOrEmpty(image.AltText))
                            {
                                <p class="text-xs text-muted-foreground px-4 py-2">@image.AltText</p>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <!-- Changelog -->
        @if (Model.ChangelogEntries.Any())
        {
            <section class="mb-12">
                <h2 class="font-heading text-2xl mb-6">Changelog</h2>
                <div class="space-y-3">
                    @foreach (var entry in Model.ChangelogEntries)
                    {
                        <div class="flex items-start gap-3 @(entry.IsMilestone ? "border-l-2 border-accent pl-4" : "pl-5")">
                            <span class="shrink-0 mt-0.5 @(entry.IsMilestone ? "text-accent" : "text-muted-foreground")">
                                @(entry.IsMilestone ? "✦" : "·")
                            </span>
                            <div>
                                <p class="text-sm text-foreground">@entry.Content</p>
                                <p class="text-xs text-muted-foreground mt-0.5">@entry.CreatedAt.ToString("MMM d, yyyy")</p>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

    </div>
}
