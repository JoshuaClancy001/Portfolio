@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="max-w-5xl mx-auto px-6 md:px-12">

    <section class="py-24 md:py-32">
        <h1 class="font-heading text-5xl md:text-7xl lg:text-8xl mb-8 tracking-tight text-foreground">
            Joshua Clancy
        </h1>
        <p class="text-xl md:text-2xl text-muted-foreground max-w-2xl">
            Full-stack software engineer building practical applications, backend services, and tools that solve real problems.
        </p>
    </section>

    <section class="py-16 border-t border-border">
        <div class="grid md:grid-cols-2 gap-16">
            <div>
                <h2 class="text-sm uppercase tracking-widest text-muted-foreground mb-6">About</h2>
                <p class="text-base leading-relaxed mb-4">
                    I build full-stack applications with a strong focus on backend systems, APIs, and product functionality.
                    My experience includes developing production tools, integrating third-party services, debugging live systems,
                    and shipping software quickly in fast-moving environments.
                </p>
            </div>
            <div>
                <h2 class="text-sm uppercase tracking-widest text-muted-foreground mb-6">Currently Building</h2>
                @if (!Model.FeaturedProjects.Any())
                {
                    <p class="text-muted-foreground text-sm">No projects yet.</p>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var project in Model.FeaturedProjects)
                        {
                            <a href="/Projects" class="block p-6 bg-secondary border border-border hover:border-accent transition-colors group">
                                <div class="flex items-start justify-between mb-2">
                                    <h3 class="font-heading group-hover:text-accent transition-colors flex-1">@project.Title</h3>
                                    <span class="text-xs px-2 py-1 ml-3 flex-shrink-0 text-background"
                                          style="background-color: @StatusColor(project.Status)">
                                        @project.Status
                                    </span>
                                </div>
                                <p class="text-sm text-muted-foreground">@project.Description</p>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

</div>

@functions {
    string StatusColor(string status) => status switch
    {
        "InProgress" => "var(--status-inprogress)",
        "Shipped"    => "var(--status-shipped)",
        "Planned"    => "var(--status-planned)",
        "Paused"     => "var(--status-paused)",
        _            => "var(--status-planned)"
    };
}
